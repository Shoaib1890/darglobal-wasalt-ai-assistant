# OpenRouter API Key (Get a free key from https://openrouter.ai/)
OPENROUTER_API_KEY=

# Default Free Model (Can be: openrouter/free, google/gemma-4-31b-it:free, nvidia/nemotron-3.5-lightning:free)
OPENROUTER_MODEL=openrouter/free

# Base API URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RAG & Retrieval Thresholds
DEFAULT_TOP_K=4
SIMILARITY_RELEVANCE_THRESHOLD=0.35
